# Keep source and scripts stable when the repository moves between macOS and Windows.
* text=auto

*.java text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.jar binary
*.zip binary
*.dmg binary
*.exe binary
*.msi binary
