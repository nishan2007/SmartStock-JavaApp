{
  "name": "smartstock-customers",
  "account_id": "5a56ab6770eaa3b32509b0594417e9dc",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../target/customers-web-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "customermanagement.deckers.gy",
      "custom_domain": true
    }
  ],
  "vars": {
    "EMPLOYEE_TUNNEL_HOST": "scheduler.deckers.gy",
    "EMPLOYEE_ORIGIN": "https://timeclock.deckers.gy",
    "PUBLIC_STORE_ID": "1"
  },
  "services": [
    {
      "binding": "STOREFRONT",
      "service": "smartstock-storefront"
    }
  ]
}
