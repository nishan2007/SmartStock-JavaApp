    "CF_ZONE_ID":"e0c3eb369e683f46a476c648aa05eaec",
    "SUPABASE_URL":"https://pxdqngbpdnpiazwuagvb.supabase.co",
    "ADMIN_ACCESS_POLICY_ID":"deb7e5a2-9cf7-4583-b104-fb3510a8b347",
    "ADMIN_ACCESS_TEAM":"deckers23",
