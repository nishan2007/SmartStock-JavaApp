# Server-side only. Never copy these values to a SmartStock desktop.
SMARTSTOCK_GATEWAY_MODE=REMOTE_ADMIN
SMARTSTOCK_DB_MODE=SERVER
SMARTSTOCK_DB_URL=jdbc:postgresql://YOUR_POOLED_CLOUD_DB_HOST:5432/postgres?sslmode=require
SMARTSTOCK_DB_USER=YOUR_SERVER_SIDE_DATABASE_USER
SMARTSTOCK_DB_PASSWORD=YOUR_SERVER_SIDE_DATABASE_PASSWORD

# Put the gateway behind a public HTTPS reverse proxy and forward to its internal port.
# java -Dsmartstock.lan.api.port=8443 -cp inventory-management-1.0.0.jar app.RemoteGatewayMain
