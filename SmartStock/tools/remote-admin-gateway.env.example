# Server-side only. Never copy these values to a SmartStock desktop.
SMARTSTOCK_GATEWAY_MODE=REMOTE_ADMIN
SMARTSTOCK_DB_MODE=SERVER
SMARTSTOCK_DB_URL=jdbc:postgresql://YOUR_POOLED_CLOUD_DB_HOST:5432/postgres?sslmode=require
SMARTSTOCK_DB_USER=YOUR_SERVER_SIDE_DATABASE_USER
SMARTSTOCK_DB_PASSWORD=YOUR_SERVER_SIDE_DATABASE_PASSWORD

# Owner scheduler. For a permanent tunnel, the origin must be exact and must not include /scheduler.
# Leave it unset to have SmartStock launch an account-free temporary trycloudflare.com tunnel.
SMARTSTOCK_SCHEDULER_PUBLIC_ORIGIN=https://scheduler.example.com
# Optional absolute path when cloudflared is not available on the gateway service PATH.
# SMARTSTOCK_CLOUDFLARED_PATH=C:\Program Files\cloudflared\cloudflared.exe
# The scheduler listener is loopback-only on port 8446. Proxy only /scheduler/*
# and /scheduler/health to it. Do not expose the register API port publicly.

# Put the gateway behind a public HTTPS reverse proxy and forward only approved paths.
# java -Dsmartstock.lan.api.port=8443 -cp inventory-management-1.0.0.jar app.RemoteGatewayMain
